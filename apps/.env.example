# VALENIA environment (development defaults)
#
# Copy to .env and adjust. `.env` is gitignored; never commit real secrets.
#
#   cp .env.example .env

# Application environment: development | production.
# `php database/migrate.php fresh` refuses to run when APP_ENV=production.
APP_ENV=development

# PostgreSQL DSN. Required — app/lib/db.php accepts only a pgsql: DSN.
# Inside Docker Compose the host is the service name `db`; for a local server
# use `localhost`.
DB_DSN=pgsql:host=db;port=5432;dbname=valenia

# PostgreSQL credentials.
DB_USER=valenia
DB_PASSWORD=valenia

DB_NAME=valenia

# Initial admin account created by `php database/seed.php`.
# Local development only. In production, set these in Dokploy.
# The account must change the password on first login (must_change_password = TRUE).
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=change-me-local-only

# Set to 1 to replace an existing admin password (and email when provided) on
# the next seed run. Keep 0 for normal runs.
SEED_ADMIN_RESET_PASSWORD=0
