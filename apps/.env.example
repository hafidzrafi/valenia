# VALENIA environment (development defaults)
#
# Copy to .env and adjust. `.env` is gitignored; never commit real secrets.
#
#   cp .env.example .env

# Application environment: development | production.
# `php database/migrate.php fresh` refuses to run when APP_ENV=production.
APP_ENV=development

# PostgreSQL DSN. Required — app/lib/db.php accepts only a pgsql: DSN.
# Inside Docker Compose the host is the service name `db`; for a local server
# use `localhost`.
DB_DSN=pgsql:host=db;port=5432;dbname=valenia

# PostgreSQL credentials.
DB_USER=valenia
DB_PASSWORD=valenia
