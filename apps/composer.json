{
    "name": "hafidzrafi/valenia",
    "description": "VALENIA: Verifikasi Antrian & Layanan Navigasi Interaktif Aplikasi Poliklinik",
    "type": "project",
    "require": {
        "php": ">=8.5.12",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "license": "MIT",
    "authors": [
        {
            "name": "SiputBiru",
            "email": "hillsforrest03@gmail.com"
        }
    ]
}
